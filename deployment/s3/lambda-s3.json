{
    "functionName": "<+service.name>-<+env.name>",
    "handler": "app.handler",
    "memorySize": 256,
    "runtime": "python3.11",
    "timeout": 30,
    "role": "<+pipeline.stages.LAmbdaInfra.spec.execution.steps.apply.output.outputVariables.lambda_iam_role_arn>",
    "environment": {
        "variables": {
            "BANK_OFFER_ID": "OFFER_JULY_PROMO",
            "DEMO_VERSION": "<+codebase.shortCommitSha>-<+pipeline.sequenceId>",
            "LOG_LEVEL": "INFO",
            "DEPLOYMENT_ENV": "<+env.name>"
        }
    },
    "packageType": "Zip",
    "code": {
        "s3Bucket": "<+pipeline.stages.LAmbdaInfra.spec.execution.steps.apply.output.outputVariables.s3_lambda_artifacts_bucket_name>",
        "s3Key": "<+pipeline.stages.Build_Lambda.spec.execution.steps.S3Upload.steps.S3Upload_1.spec.target>/lambda_deploy_package.zip"
        "s3ObjectVersion": "<+codebase.shortCommitSha>-<+pipeline.sequenceId>" 
    }
}
